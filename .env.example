# Msingi AZ-900 Study Platform Configuration

# -------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Client-Side)
# -------------------------------------------------------------
# Supabase project URL & public anonymous key
# (Optional: falls back to browser-backed LocalMock storage if omitted)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -------------------------------------------------------------
# 2. VERCEL SERVERLESS BACKEND VARIABLES (api/*)
# -------------------------------------------------------------
# Google Gemini API key (recommended: keep on server side, safe from browser inspection)
# Set this in your Vercel Project Settings > Environment Variables
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Optional: Supabase Service Role Key for server-side admin operations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
